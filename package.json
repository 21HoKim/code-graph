{
  "name": "code-graph-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.5.0",
  "publisher": "21HoKim",
  "license": "MIT",
  "author": {
    "name": "김호 (21HoKim)"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/21HoKim/code-graph"
  },
  "bugs": {
    "url": "https://github.com/21HoKim/code-graph/issues"
  },
  "homepage": "https://github.com/21HoKim/code-graph#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "visualization",
    "call graph",
    "architecture",
    "c++",
    "python",
    "threads",
    "dataflow",
    "topology",
    "circuit",
    "tracing",
    "runtime",
    "compile errors",
    "docker",
    "docker compose",
    "codegraph",
    "code graph",
    "visualizer",
    "code visualizer",
    "code visualization",
    "graph view",
    "code map",
    "diagram",
    "dependency graph",
    "flowchart",
    "call hierarchy",
    "c"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b0f14",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onWebviewPanel:codeGraph.circuit"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%trust.description%",
      "restrictedConfigurations": [
        "codeGraph.verify.cc",
        "codeGraph.verify.cxx",
        "codeGraph.verify.python",
        "codeGraph.verify.extraFlags",
        "codeGraph.run.entry",
        "codeGraph.run.args",
        "codeGraph.run.cwd",
        "codeGraph.run.env",
        "codeGraph.run.buildFlags",
        "codeGraph.run.linkFlags",
        "codeGraph.run.useBuildSystem",
        "codeGraph.run.compose.file",
        "codeGraph.run.compose.docker"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codeGraph.open",
        "title": "%cmd.open%",
        "category": "CodeGraph",
        "icon": "$(circuit-board)"
      },
      {
        "command": "codeGraph.showFile",
        "title": "%cmd.showFile%",
        "category": "CodeGraph",
        "icon": "$(circuit-board)"
      },
      {
        "command": "codeGraph.reanalyze",
        "title": "%cmd.reanalyze%",
        "category": "CodeGraph",
        "icon": "$(refresh)"
      },
      {
        "command": "codeGraph.verify",
        "title": "%cmd.verify%",
        "category": "CodeGraph",
        "icon": "$(check-all)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "codeGraph.runTrace",
        "title": "%cmd.runTrace%",
        "category": "CodeGraph",
        "icon": "$(debug-start)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "codeGraph.runCompose",
        "title": "%cmd.runCompose%",
        "category": "CodeGraph",
        "icon": "$(server-process)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "codeGraph.stopRun",
        "title": "%cmd.stopRun%",
        "category": "CodeGraph",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codeGraph.splitTrace",
        "title": "%cmd.splitTrace%",
        "category": "CodeGraph",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "codeGraph.createConfig",
        "title": "%cmd.createConfig%",
        "category": "CodeGraph",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codeGraph.loadTrace",
        "title": "%cmd.loadTrace%",
        "category": "CodeGraph"
      },
      {
        "command": "codeGraph.clearTrace",
        "title": "%cmd.clearTrace%",
        "category": "CodeGraph"
      },
      {
        "command": "codeGraph.exportGraph",
        "title": "%cmd.export%",
        "category": "CodeGraph"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeGraph",
          "title": "CodeGraph",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "codeGraph": [
        {
          "id": "codeGraph.home",
          "name": "CodeGraph"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeGraph.home",
        "contents": "%welcome.open%"
      },
      {
        "view": "codeGraph.home",
        "contents": "%welcome.check%",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "codeGraph.home",
        "contents": "%welcome.compose%",
        "when": "codeGraph.hasCompose && isWorkspaceTrusted"
      },
      {
        "view": "codeGraph.home",
        "contents": "%welcome.config%",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "codeGraph.home",
        "contents": "%welcome.untrusted%",
        "when": "!isWorkspaceTrusted"
      },
      {
        "view": "codeGraph.home",
        "contents": "%welcome.more%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeGraph.stopRun",
          "when": "view == codeGraph.home && codeGraph.running",
          "group": "navigation@0"
        },
        {
          "command": "codeGraph.reanalyze",
          "when": "view == codeGraph.home",
          "group": "navigation@1"
        },
        {
          "command": "codeGraph.exportGraph",
          "when": "view == codeGraph.home",
          "group": "2_tools@1"
        },
        {
          "command": "codeGraph.clearTrace",
          "when": "view == codeGraph.home",
          "group": "2_tools@2"
        },
        {
          "command": "codeGraph.createConfig",
          "when": "view == codeGraph.home",
          "group": "2_tools@3"
        }
      ],
      "explorer/context": [
        {
          "command": "codeGraph.showFile",
          "when": "resourceExtname =~ /^\\.(c|h|cc|cpp|cxx|hpp|hh|hxx|py)$/",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "codeGraph.showFile",
          "when": "editorLangId =~ /^(c|cpp|python)$/",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "command": "codeGraph.showFile",
          "when": "editorLangId =~ /^(c|cpp|python)$/",
          "group": "navigation@90"
        },
        {
          "command": "codeGraph.runTrace",
          "when": "editorLangId =~ /^(c|cpp|python)$/ && isWorkspaceTrusted",
          "group": "navigation@91"
        }
      ],
      "commandPalette": [
        {
          "command": "codeGraph.splitTrace",
          "when": "codeGraph.multiProcess"
        },
        {
          "command": "codeGraph.stopRun",
          "when": "codeGraph.running"
        }
      ]
    },
    "configuration": {
      "title": "CodeGraph",
      "properties": {
        "codeGraph.defaultLevel": {
          "type": "string",
          "enum": [
            "auto",
            "dir",
            "file",
            "namespace",
            "class",
            "function"
          ],
          "default": "auto",
          "markdownDescription": "%cfg.defaultLevel%"
        },
        "codeGraph.layout": {
          "type": "string",
          "enum": [
            "circuit",
            "network"
          ],
          "default": "circuit",
          "markdownDescription": "%cfg.layout%"
        },
        "codeGraph.flow.mode": {
          "type": "string",
          "enum": [
            "all",
            "focus",
            "off"
          ],
          "default": "all",
          "markdownDescription": "%cfg.flowMode%"
        },
        "codeGraph.flow.maxParticles": {
          "type": "number",
          "default": 2500,
          "minimum": 0,
          "markdownDescription": "%cfg.maxParticles%"
        },
        "codeGraph.showGuessedLinks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.guesses%"
        },
        "codeGraph.followCursor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.followCursor%"
        },
        "codeGraph.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/build/**",
            "**/out/**",
            "**/dist/**",
            "**/.venv/**",
            "**/venv/**",
            "**/__pycache__/**",
            "**/third_party/**",
            "**/site-packages/**"
          ],
          "markdownDescription": "%cfg.exclude%"
        },
        "codeGraph.maxFiles": {
          "type": "number",
          "default": 3000,
          "minimum": 1,
          "markdownDescription": "%cfg.maxFiles%"
        },
        "codeGraph.cpp.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.includePaths%"
        },
        "codeGraph.analysis.workers": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 16,
          "markdownDescription": "%cfg.workers%"
        },
        "codeGraph.verify.mode": {
          "type": "string",
          "enum": [
            "onOpenAndSave",
            "onOpen",
            "manual"
          ],
          "enumDescriptions": [
            "%cfg.verifyMode.onOpenAndSave%",
            "%cfg.verifyMode.onOpen%",
            "%cfg.verifyMode.manual%"
          ],
          "default": "onOpenAndSave",
          "markdownDescription": "%cfg.verifyMode%"
        },
        "codeGraph.verify.cc": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.verifyCc%"
        },
        "codeGraph.verify.cxx": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.verifyCxx%"
        },
        "codeGraph.verify.python": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.verifyPython%"
        },
        "codeGraph.verify.extraFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.verifyFlags%"
        },
        "codeGraph.verify.useCompileCommands": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.verifyCcdb%"
        },
        "codeGraph.verify.editorDiagnostics": {
          "type": "string",
          "enum": [
            "off",
            "errors"
          ],
          "default": "off",
          "markdownDescription": "%cfg.verifyEditor%"
        },
        "codeGraph.verify.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "markdownDescription": "%cfg.verifyTimeout%"
        },
        "codeGraph.run.entry": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.runEntry%"
        },
        "codeGraph.run.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.runArgs%"
        },
        "codeGraph.run.cwd": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.runCwd%"
        },
        "codeGraph.run.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "%cfg.runEnv%"
        },
        "codeGraph.run.buildFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.runBuildFlags%"
        },
        "codeGraph.run.linkFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.runLinkFlags%"
        },
        "codeGraph.run.useBuildSystem": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.runUseBuildSystem%"
        },
        "codeGraph.run.target": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.runTarget%"
        },
        "codeGraph.run.compose.file": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.composeFile%"
        },
        "codeGraph.run.compose.services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.composeServices%"
        },
        "codeGraph.run.compose.startTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 10,
          "markdownDescription": "%cfg.composeStartTimeout%"
        },
        "codeGraph.run.compose.docker": {
          "type": "string",
          "default": "docker",
          "markdownDescription": "%cfg.composeDocker%"
        },
        "codeGraph.run.timeoutSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%cfg.runTimeout%"
        },
        "codeGraph.run.maxEvents": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "markdownDescription": "%cfg.runMaxEvents%"
        },
        "codeGraph.run.captureValues": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.runValues%"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".codegraph.json",
        "url": "./schemas/codegraph.schema.json"
      }
    ],
    "languages": [
      {
        "id": "jsonc",
        "filenames": [
          ".codegraph.json"
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/build.mjs --tests && node --test out-test/*.test.js",
    "analyze": "node dist/cli.js",
    "demo": "node scripts/build.mjs && node dist/cli.js samples/cpp-router -o out/cpp.json --quiet --verify && node dist/cli.js samples/py-pipeline -o out/py.json --quiet --verify && node dist/cli.js samples/c-ringbuf -o out/c.json --quiet --verify && (node dist/cli.js samples/broken-cpp -o out/bcpp.json --quiet --verify || true) && (node dist/cli.js samples/broken-py -o out/bpy.json --quiet --verify || true) && node dist/cli.js trace samples/cpp-router -o out/run-cpp.json && node dist/cli.js trace samples/py-pipeline -o out/run-py.json -- --seconds 0.6 && node dist/cli.js trace samples/c-ringbuf -o out/run-c.json && node scripts/build-demo.mjs out/demo.html en \"out/cpp.json:C++ router (run trace):out/run-cpp.json\" \"out/py.json:Python pipeline (run trace):out/run-py.json\" \"out/c.json:C ring buffer (run trace):out/run-c.json\" \"out/bcpp.json:Broken C++ (compile check)\" \"out/bpy.json:Broken Python (compile check)\"",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-python": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "elkjs": "^0.12.1",
    "shiki": "^4.6.0",
    "web-tree-sitter": "^0.27.2"
  }
}
