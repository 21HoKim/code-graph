{
  "name": "code-current",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "21hokim",
  "license": "MIT",
  "author": {
    "name": "김호 (21HoKim)"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/21HoKim/code-graph"
  },
  "bugs": {
    "url": "https://github.com/21HoKim/code-graph/issues"
  },
  "homepage": "https://github.com/21HoKim/code-graph#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "visualization",
    "call graph",
    "architecture",
    "c++",
    "python",
    "threads",
    "dataflow",
    "topology",
    "circuit",
    "tracing",
    "runtime",
    "compile errors"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b0f14",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onWebviewPanel:codeCurrent.circuit"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%trust.description%",
      "restrictedConfigurations": [
        "codeCurrent.verify.cc",
        "codeCurrent.verify.cxx",
        "codeCurrent.verify.python",
        "codeCurrent.verify.extraFlags",
        "codeCurrent.run.entry",
        "codeCurrent.run.args",
        "codeCurrent.run.cwd",
        "codeCurrent.run.env",
        "codeCurrent.run.buildFlags",
        "codeCurrent.run.linkFlags"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codeCurrent.open",
        "title": "%cmd.open%",
        "category": "CodeCurrent",
        "icon": "$(circuit-board)"
      },
      {
        "command": "codeCurrent.showFile",
        "title": "%cmd.showFile%",
        "category": "CodeCurrent",
        "icon": "$(circuit-board)"
      },
      {
        "command": "codeCurrent.reanalyze",
        "title": "%cmd.reanalyze%",
        "category": "CodeCurrent"
      },
      {
        "command": "codeCurrent.verify",
        "title": "%cmd.verify%",
        "category": "CodeCurrent",
        "icon": "$(check-all)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "codeCurrent.runTrace",
        "title": "%cmd.runTrace%",
        "category": "CodeCurrent",
        "icon": "$(debug-start)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "codeCurrent.loadTrace",
        "title": "%cmd.loadTrace%",
        "category": "CodeCurrent"
      },
      {
        "command": "codeCurrent.clearTrace",
        "title": "%cmd.clearTrace%",
        "category": "CodeCurrent"
      },
      {
        "command": "codeCurrent.exportGraph",
        "title": "%cmd.export%",
        "category": "CodeCurrent"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codeCurrent.showFile",
          "when": "resourceExtname =~ /^\\.(c|h|cc|cpp|cxx|hpp|hh|hxx|py)$/",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "codeCurrent.showFile",
          "when": "editorLangId =~ /^(c|cpp|python)$/",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "command": "codeCurrent.showFile",
          "when": "editorLangId =~ /^(c|cpp|python)$/",
          "group": "navigation@90"
        },
        {
          "command": "codeCurrent.runTrace",
          "when": "editorLangId =~ /^(c|cpp|python)$/ && isWorkspaceTrusted",
          "group": "navigation@91"
        }
      ]
    },
    "configuration": {
      "title": "CodeCurrent",
      "properties": {
        "codeCurrent.defaultLevel": {
          "type": "string",
          "enum": [
            "auto",
            "dir",
            "file",
            "namespace",
            "class",
            "function"
          ],
          "default": "auto",
          "markdownDescription": "%cfg.defaultLevel%"
        },
        "codeCurrent.layout": {
          "type": "string",
          "enum": [
            "circuit",
            "network"
          ],
          "default": "circuit",
          "markdownDescription": "%cfg.layout%"
        },
        "codeCurrent.flow.mode": {
          "type": "string",
          "enum": [
            "all",
            "focus",
            "off"
          ],
          "default": "all",
          "markdownDescription": "%cfg.flowMode%"
        },
        "codeCurrent.flow.maxParticles": {
          "type": "number",
          "default": 2500,
          "minimum": 0,
          "markdownDescription": "%cfg.maxParticles%"
        },
        "codeCurrent.showGuessedLinks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.guesses%"
        },
        "codeCurrent.followCursor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.followCursor%"
        },
        "codeCurrent.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/build/**",
            "**/out/**",
            "**/dist/**",
            "**/.venv/**",
            "**/venv/**",
            "**/__pycache__/**",
            "**/third_party/**",
            "**/site-packages/**"
          ],
          "markdownDescription": "%cfg.exclude%"
        },
        "codeCurrent.maxFiles": {
          "type": "number",
          "default": 3000,
          "minimum": 1,
          "markdownDescription": "%cfg.maxFiles%"
        },
        "codeCurrent.cpp.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.includePaths%"
        },
        "codeCurrent.analysis.workers": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 16,
          "markdownDescription": "%cfg.workers%"
        },
        "codeCurrent.verify.mode": {
          "type": "string",
          "enum": [
            "onOpenAndSave",
            "onOpen",
            "manual"
          ],
          "enumDescriptions": [
            "%cfg.verifyMode.onOpenAndSave%",
            "%cfg.verifyMode.onOpen%",
            "%cfg.verifyMode.manual%"
          ],
          "default": "onOpenAndSave",
          "markdownDescription": "%cfg.verifyMode%"
        },
        "codeCurrent.verify.cc": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.verifyCc%"
        },
        "codeCurrent.verify.cxx": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.verifyCxx%"
        },
        "codeCurrent.verify.python": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.verifyPython%"
        },
        "codeCurrent.verify.extraFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.verifyFlags%"
        },
        "codeCurrent.verify.useCompileCommands": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.verifyCcdb%"
        },
        "codeCurrent.verify.editorDiagnostics": {
          "type": "string",
          "enum": [
            "off",
            "errors"
          ],
          "default": "off",
          "markdownDescription": "%cfg.verifyEditor%"
        },
        "codeCurrent.verify.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "markdownDescription": "%cfg.verifyTimeout%"
        },
        "codeCurrent.run.entry": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.runEntry%"
        },
        "codeCurrent.run.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.runArgs%"
        },
        "codeCurrent.run.cwd": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.runCwd%"
        },
        "codeCurrent.run.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "%cfg.runEnv%"
        },
        "codeCurrent.run.buildFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.runBuildFlags%"
        },
        "codeCurrent.run.linkFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%cfg.runLinkFlags%"
        },
        "codeCurrent.run.timeoutSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "markdownDescription": "%cfg.runTimeout%"
        },
        "codeCurrent.run.maxEvents": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "markdownDescription": "%cfg.runMaxEvents%"
        },
        "codeCurrent.run.captureValues": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.runValues%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/build.mjs --tests && node --test out-test/*.test.js",
    "analyze": "node dist/cli.js",
    "demo": "node scripts/build.mjs && node dist/cli.js samples/cpp-router -o out/cpp.json --quiet --verify && node dist/cli.js samples/py-pipeline -o out/py.json --quiet --verify && node dist/cli.js samples/c-ringbuf -o out/c.json --quiet --verify && (node dist/cli.js samples/broken-cpp -o out/bcpp.json --quiet --verify || true) && (node dist/cli.js samples/broken-py -o out/bpy.json --quiet --verify || true) && node dist/cli.js trace samples/cpp-router -o out/run-cpp.json && node dist/cli.js trace samples/py-pipeline -o out/run-py.json -- --seconds 0.6 && node dist/cli.js trace samples/c-ringbuf -o out/run-c.json && node scripts/build-demo.mjs out/demo.html en \"out/cpp.json:C++ router (run trace):out/run-cpp.json\" \"out/py.json:Python pipeline (run trace):out/run-py.json\" \"out/c.json:C ring buffer (run trace):out/run-c.json\" \"out/bcpp.json:Broken C++ (compile check)\" \"out/bpy.json:Broken Python (compile check)\"",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-python": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "elkjs": "^0.12.1",
    "web-tree-sitter": "^0.27.2"
  }
}
